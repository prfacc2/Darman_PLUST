// DarmanPlus resources: embedded Vazirmatn fonts + version info + manifest
#include <windows.h>

// v1.66.0: application icon — multi-size (16/24/32/48/64/128/256) circular
// «درمان پلاس» logo. Lowest-ID ICON resource = the icon Explorer shows on the
// EXE; also loaded at runtime for the window class + taskbar (WM_SETICON).
1 ICON "../assets/icons/app.ico"

101 RCDATA "../fonts/Vazir-Regular.ttf"
102 RCDATA "../fonts/Vazir-Bold.ttf"

// v1.3.0: embedded background images (light / dark) for the welcome screen
103 RCDATA "../assets/bg_light.jpg"
104 RCDATA "../assets/bg_dark.jpg"

// v1.4.1: real (raster) print-action icons — white-on-alpha PNGs that are
// tinted to the theme accent at draw time (gpDrawTintedImageRes).
201 RCDATA "../assets/icons/ic_printer.png"
202 RCDATA "../assets/icons/ic_receipt.png"
203 RCDATA "../assets/icons/ic_shield.png"
204 RCDATA "../assets/icons/ic_last.png"
// v1.8.0: settings (gear) + calculator raster icons — white-on-alpha PNGs that
// are tinted to the theme accent at draw time so they read cleanly on BOTH the
// light and the dark theme.
205 RCDATA "../assets/icons/ic_settings.png"
206 RCDATA "../assets/icons/ic_calc.png"

// v1.64.0 (درمان پلاس): the circular brand logo, embedded as a real PNG and
// drawn into a circle on the welcome screen, the login card and the header.
207 RCDATA "../assets/icons/logo.png"

// v1.19.0: embedded HTML/CSS/JS print designer (served by the in-app local
// HTTP host and rendered in an app-owned WebView window — never the external
// browser). Each asset is a raw RCDATA blob served verbatim.
300 RCDATA "../assets/designer/index.html"
301 RCDATA "../assets/designer/designer.css"
302 RCDATA "../assets/designer/bootstrap.min.css"
303 RCDATA "../assets/designer/fields.js"
304 RCDATA "../assets/designer/templates.js"
305 RCDATA "../assets/designer/designer.js"

// v1.33.0: embedded HTML/CSS/JS Patient-Admission surface (served by the in-app
// loopback host and rendered inside an embedded WebView2 control — never the
// external browser). Each asset is a raw RCDATA blob served verbatim.
400 RCDATA "../assets/admission/index.html"
401 RCDATA "../assets/admission/admission.css"
402 RCDATA "../assets/admission/bridge.js"
403 RCDATA "../assets/admission/admission.js"
404 RCDATA "../assets/admission/vazir.ttf"
405 RCDATA "../assets/admission/contextmenu.js"

// v1.40.0: shared multi-page embedded-web SHELL assets — one common stylesheet
// (RTL Persian + Vazirmatn + themes), one common runtime (AzBridge/AzUi/AzNav/
// AzBoot/AzPerf helpers) and the embedded Vazirmatn font every page pulls in.
// Served by the generic WebPages_* dispatcher (src/web_pages.cpp). Ids 500..502
// are RESERVED for the shell and MUST NOT collide with the admission (400..405)
// or ping (600..602) blocks.
500 RCDATA "../assets/shell/common.css"
501 RCDATA "../assets/shell/common.js"
502 RCDATA "../assets/shell/vazir.ttf"

// v1.40.0: demo «ping» page proving the multi-page shell end-to-end — a page
// registered in the WebPages_* registry, served through the thread pool, with a
// dedicated /api verb (ping) handled by src/web_ping_api.cpp. Ids 600..602.
600 RCDATA "../assets/pages/ping/index.html"
601 RCDATA "../assets/pages/ping/ping.css"
602 RCDATA "../assets/pages/ping/ping.js"

// v1.70.0: embedded HTML/CSS/JS CRM Management surface — the «مدیریت درمانگاه»
// panel rendered by an embedded WebView2 (or the universal MSHTML fallback)
// inside the manage tab, replacing the legacy native C++/GDI manage panel. The
// page is fully INLINED from these blobs (serverless: no local server / port),
// and talks to C++ through the window.external.azCall / postMessage bridge
// handled by src/web_crm.cpp. Ids 800..810 are RESERVED for the CRM and MUST
// NOT collide with the admission (400..405), shell (500..502), ping (600..602)
// or WebView2Loader (700) blocks. The shared shell assets (500..502) are also
// pulled in by the inliner so the CRM page reuses the common RTL/Vazirmatn
// runtime + AzBridge transport.
800 RCDATA "../assets/crm/index.html"
801 RCDATA "../assets/crm/crm.css"
802 RCDATA "../assets/crm/crm.js"
803 RCDATA "../assets/crm/dashboard.js"
804 RCDATA "../assets/crm/sections.js"
805 RCDATA "../assets/crm/patients.js"
806 RCDATA "../assets/crm/doctors.js"
807 RCDATA "../assets/crm/services.js"
808 RCDATA "../assets/crm/accounts.js"
809 RCDATA "../assets/crm/messages.js"
810 RCDATA "../assets/crm/settings.js"
811 RCDATA "../assets/crm/insurance.js"
// v1.77.0: crm.js was split into focused modules for maintainability — the
// hamburger nav drawer (crm_menu.js) and the themed modal/confirm/alert dialogs
// (crm_dialogs.js) are now separate RCDATA blobs, inlined into the page by
// web_crm_embed.inc in the same <script> order as index.html. Ids 812..813.
812 RCDATA "../assets/crm/crm_menu.js"
813 RCDATA "../assets/crm/crm_dialogs.js"
// v1.79.0: «تعریف پرسنل» (personnel registry) page. The old employees.js page
// was rebuilt as «تعریف حساب کاربری» (accounts.js, id 808 above) — personnel-
// linked account creation + access ticks + filters; the departments card moved
// into it so no capability was lost.
814 RCDATA "../assets/crm/persons.js"
// v1.82.0: work calendar + HTML backup page
815 RCDATA "../assets/crm/calendar.js"
816 RCDATA "../assets/crm/backup.js"

// v1.68.0: the redistributable WebView2 loader (x86). Extracted to a per-user
// writable folder at first use so the embedded Patient-Admission surface can
// light up the modern Chromium engine on any machine that has the Evergreen
// runtime (Win10/11 with Edge), without shipping a loose DLL next to the EXE.
// On machines WITHOUT the runtime the loader's version probe simply fails and
// the universal MSHTML fallback is used — so this is strictly additive.
700 RCDATA "../assets/runtime/WebView2Loader.dll"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION 1,83,0,0
  PRODUCTVERSION 1,83,0,0
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DarmanPlus"
            VALUE "FileDescription", "DarmanPlus Clinic Reception & Management System"
            VALUE "FileVersion", "1.83.0.0"
            VALUE "InternalName", "DarmanPlus"
            VALUE "OriginalFilename", "DarmanPlus.exe"
            VALUE "ProductName", "DarmanPlus"
            VALUE "ProductVersion", "1.83.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
